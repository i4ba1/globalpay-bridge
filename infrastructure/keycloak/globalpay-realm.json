{
  "realm": "globalpay",
  "enabled": true,
  "displayName": "GlobalPay Bridge",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      { "name": "Admin", "description": "Client payroll administrator" },
      { "name": "Approver", "description": "Payroll approver" },
      { "name": "Finance", "description": "Finance operator" },
      { "name": "Auditor", "description": "Read-only auditor" },
      { "name": "IntegrationPartner", "description": "Scoped API and webhook access" },
      { "name": "PlatformOperator", "description": "Platform operator" }
    ]
  },
  "clientScopes": [
    {
      "name": "globalpay-claims",
      "description": "GlobalPay tenant and role claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-as-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "claim.name": "tenant_id",
            "user.attribute": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "globalpay-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "globalpay-api",
      "name": "GlobalPay API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["globalpay-claims"]
    },
    {
      "clientId": "globalpay-cli",
      "name": "GlobalPay CLI (local token acquisition)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5080/*", "http://localhost:5090/*"],
      "webOrigins": ["+"],
      "defaultClientScopes": ["globalpay-claims"]
    }
  ],
  "users": [
    {
      "username": "admin.user",
      "enabled": true,
      "emailVerified": true,
      "email": "admin.user@example.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [{ "type": "password", "value": "Password123!", "temporary": false }],
      "realmRoles": ["Admin"]
    },
    {
      "username": "approver.user",
      "enabled": true,
      "emailVerified": true,
      "email": "approver.user@example.test",
      "firstName": "Paul",
      "lastName": "Approver",
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [{ "type": "password", "value": "Password123!", "temporary": false }],
      "realmRoles": ["Approver"]
    },
    {
      "username": "finance.user",
      "enabled": true,
      "emailVerified": true,
      "email": "finance.user@example.test",
      "firstName": "Fiona",
      "lastName": "Finance",
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [{ "type": "password", "value": "Password123!", "temporary": false }],
      "realmRoles": ["Finance"]
    },
    {
      "username": "auditor.user",
      "enabled": true,
      "emailVerified": true,
      "email": "auditor.user@example.test",
      "firstName": "Al",
      "lastName": "Auditor",
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [{ "type": "password", "value": "Password123!", "temporary": false }],
      "realmRoles": ["Auditor"]
    },
    {
      "username": "tenant.b.admin",
      "enabled": true,
      "emailVerified": true,
      "email": "tenant.b.admin@example.test",
      "firstName": "Bea",
      "lastName": "Second",
      "attributes": { "tenant_id": ["22222222-2222-2222-2222-222222222222"] },
      "credentials": [{ "type": "password", "value": "Password123!", "temporary": false }],
      "realmRoles": ["Admin"]
    }
  ]
}
